; Script generated by VietPhotoBooth Build System
; Inno Setup 6 Script for VietPhotoBooth Windows Installer

#define MyAppName "VietPhotoBooth"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "VietPhotoBooth Team"
#define MyAppURL "https://github.com/PhotoboothProject/photobooth"
#define MyAppExeName "VietPhotoBooth.exe"

[Setup]
; App Identity
AppId={{676858C6-2A30-4E77-A479-D21F91264A09}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}

; Installation Target
DefaultDirName={userappdata}\Programs\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes

; Packaging and Output
OutputDir=c:\Users\Admin\Documents\photobooth\dist_installer
OutputBaseFilename=VietPhotoBooth-Setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern

; Platform Requirements
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.10240

; Privileges
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=commandline dialog

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "c:\Users\Admin\Documents\photobooth\dist\VietPhotoBooth\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "Khởi động VietPhotoBooth ngay bây giờ"; Flags: nowait postinstall skipifsilent
