; Script generated by 1998 TEAM Photobooth Build System
; Inno Setup 6 Script for 1998 TEAM — Photobooth Windows Installer

#define MyAppName "1998 TEAM — Photobooth"
#define MyAppVersion "1.1.0"
#define MyAppPublisher "1998 Studio"
#define MyAppURL "https://github.com/PhotoboothProject/photobooth"
#define MyAppExeName "1998TeamPhotobooth.exe"

[Setup]
; App Identity
AppId={{676858C6-2A30-4E77-A479-D21F91264A09}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}

; Installation Target
DefaultDirName={localappdata}\Programs\1998TeamPhotobooth
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes

; Packaging and Output
OutputDir=c:\Users\Admin\Documents\photobooth\dist_installer
OutputBaseFilename=1998-TEAM-Setup
SetupIconFile=c:\Users\Admin\Documents\photobooth\Assets\Branding\app_icon.ico
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern

; Platform Requirements
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.10240

; Privileges
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=commandline dialog

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "c:\Users\Admin\Documents\photobooth\dist\1998TeamPhotobooth\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon; IconFilename: "{app}\{#MyAppExeName}"

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "Khởi động 1998 TEAM — Photobooth ngay bây giờ"; Flags: nowait postinstall skipifsilent
